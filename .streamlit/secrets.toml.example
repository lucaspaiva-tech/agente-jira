# Copie para .streamlit/secrets.toml e preencha. O secrets.toml NUNCA vai pro Git.
# No Hub, cole no campo Segredos do app só SUPABASE_URL, SUPABASE_SERVICE_KEY e JIRA_BASE_URL.
# NUNCA cole AMBIENTE nem USUARIO_LOCAL_EMAIL no Hub.

SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_KEY = "cole-aqui-a-chave-service_role"

# Só na sua máquina: simula o usuário logado no Hub
AMBIENTE = "local"
USUARIO_LOCAL_EMAIL = "lucas.paiva@buser.com.br"

# Endereço do Jira, para montar o link de cada ticket (ex.: https://empresa.atlassian.net)
JIRA_BASE_URL = "https://SEU-SITE.atlassian.net"
